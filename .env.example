# Main read-only Hermes agent API (server-side only); no separate holder profile.
# Full API base BEFORE /v1, e.g. https://<api-host>.
# Use the main agent's API_SERVER_KEY; the dashboard URL may not expose its API.
HERMES_API_URL=
HERMES_API_KEY=
# Optional: set to an ID returned by /v1/models; otherwise a single ID is auto-selected.
HERMES_API_MODEL=

# Hosted MCP services
WEB_HOST=127.0.0.1
WEB_PORT=8780
WEB_ORIGIN=http://localhost:8780
ARBITRAGE_MCP_URL=http://localhost:8781/mcp
ARBITRAGE_MCP_TOKEN=
EXECUTION_MCP_URL=http://localhost:8782/mcp
GOVERNANCE_MCP_URL=http://localhost:8783/mcp

# Pyth Pro: server-side only
PYTH_PRO_ACCESS_TOKEN=

# Solana and governance
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_CLUSTER=mainnet-beta
REALMS_REALM_ADDRESS=HLbzfAQP4b5oFBh8CeQ6DQSX1zr8kjjejxuywU2yYeCK
REALMS_GOVERNANCE_ADDRESS=Haf7oXbQ1JREia8gWk9yv3ebtv9BXMiL1jgzo5LSVkhD
SPL_GOVERNANCE_PROGRAM_ID=GovER5Lthms3bLBqWub97yVrMmEogzX7xNjdXpPPCVZw
STRATEGY_REGISTRY_PROGRAM_ID=
GOVERNANCE_MONITOR_COMMITMENT=finalized
GOVERNANCE_RECONCILE_INTERVAL_SECONDS=30
DAO_TREASURY_ADDRESS=
STRATEGY_VAULT_ADDRESS=
AFTERHOUR_TOKEN_MINT=A9FBHUz352WGYC3GUpPdQe1bKUCLojvLMsa5uxatuYwn
# This mint is used for governance; public chat does not check balances.

# Anonymous chat uses a bounded in-memory store for one web process.
# Sessions: 1 hour. No wallet or token requirement.
# Restarting expires sessions; use a shared atomic store before multi-replica hosting.

# Delegated signer: configure through the deployment secret store only
STRATEGY_SIGNER_SECRET=

# Storage
DATABASE_URL=
