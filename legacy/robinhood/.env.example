# Use a DEDICATED Robinhood Chain wallet. Keep its private key out of Git.
AGENT_PRIVATE_KEY=
# Address of YOUR Pons V2 launched token, filled after launch.
PONS_TOKEN_ADDRESS=
# Optional: address of a separate wallet that will initiate the Pons launch.
PONS_LAUNCHER_ADDRESS=
# Optional public creator wallet for the status page. This is an address, never a key.
AGENT_PUBLIC_ADDRESS=
RPC_URL=https://rpc.mainnet.chain.robinhood.com
ORACLE_URL=https://afterhoursoracle.xyz

# creator-fees spends only verified Pons claims. wallet spends an existing USDG
# balance up to a fixed total cap, even before the token launches.
FUNDING_MODE=creator-fees
# One-time wallet-ledger migration after a verified Pons launch.
MIGRATE_WALLET_TO_CREATOR_FEES=false
WALLET_TOTAL_BUDGET_USDG=0
# Default is read-only. Paid Oracle requests and stock purchases require true.
LIVE_TRADING=false
STOCK_TOKEN_ELIGIBILITY_CONFIRMED=false
POLL_MINUTES=1

# Only Pons V2 launches paired with USDG are supported.
# Pons V2 fee escrow is pinned in src/config.js.
MIN_CLAIM_USDG=1
MIN_GAS_ETH=0.001
# Optional bounded, automatic USDG -> native ETH refill through the pinned
# Robinhood Chain Uniswap v4 ETH/USDG pool. Still needs starter ETH for gas.
AUTO_GAS_REFILL_ENABLED=false
GAS_REFILL_USDG=10
MAX_GAS_REFILL_DAILY_USDG=30
GAS_REFILL_SLIPPAGE_PCT=0.5

# A discount to the last NYSE close is a signal, not an intrinsic valuation.
MIN_DISCOUNT_PCT=0.6
MIN_EXECUTION_DISCOUNT_PCT=0.6
MAX_ROUTE_MARKUP_PCT=1
MAX_SIGNAL_AGE_SECONDS=45
MAX_CLOSE_AGE_DAYS=4
BUY_USDG=5
MAX_DAILY_USDG=0
MAX_BUYS_PER_DAY=0
MAX_API_DAILY_USDG=0
MAX_API_FEE_USDG=0.05
MAX_SLIPPAGE_PCT=0.25
# Zero disables the projected-profit gate. The agent still logs an estimate when
# available, and still enforces the price discount, spending, and swap bounds.
MIN_EXPECTED_NET_PROFIT_PCT=0
EXIT_COST_BUFFER_PCT=0.3
ESTIMATED_GAS_UNITS_PER_LEG=250000

# Optional Robinhood Chain UniswapX V3 treasury exit. The Railway service also
# accepts the existing UNISWA_API_KEY spelling. A quote never triggers a sale
# unless EXIT_ENABLED=true and onchain inventory and the treasury target pass.
UNISWAP_API_KEY=
EXIT_ENABLED=false
EXIT_WINDOW_MINUTES=60
EXIT_MIN_PROFIT_USDG=1

# Optional agent-wallet buyback and supply-reducing burn of $AFTERHOURS.
# Uses cumulative confirmed Stock Token sale proceeds less acquisition cost.
# Oracle payments and ETH gas are tracked separately but do not reduce this
# gross trading-spread buyback allocation. Unrealized gains are excluded.
BUYBACK_ENABLED=false
BUYBACK_MIN_USDG=1
BUYBACK_MAX_USDG=100
BUYBACK_CASH_RESERVE_USDG=100
BUYBACK_SLIPPAGE_PCT=0.5
BUYBACK_MAX_IMPACT_PCT=2

# Oracle payment recipient observed on its public 402 challenge. Check it before live use.
ORACLE_PAY_TO=0x13c2C376eC8884099cb9424F4d97D32FD2a956Fa

# Optional X account publishing. Keep disabled until the account, label, and API access work.
# X_API_KEY/SECRET identify the developer app; ACCESS_TOKEN/SECRET must belong to the bot account.
X_POSTING_ENABLED=false
DEXSCREENER_PROFILE_WATCH_ENABLED=false
# Set only after verifying the token's Enhanced Token Info order is finalized in your DEX Screener account.
# DEXSCREENER_APPROVED_ORDER_ID=
X_ACCOUNT_HANDLE=
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=
X_AUTOMATED_LABEL_CONFIRMED=false
# 0 removes only the agent's cap. X still applies its own account-level posting limits.
X_MAX_POSTS_PER_DAY=0
# Post a stock-buy receipt after each 10 confirmed buys. Confirmed UniswapX
# sales and completed buyback burns have separate one-time posts when X is enabled.
# 0 restores legacy per-event stock-buy posts.
X_BUYS_PER_POST=10
# Optional ISO UTC cutoff for old payment and buy events when changing posting policy.
# X_POST_EVENTS_AFTER=2026-09-20T08:35:00.000Z

# Optional OpenAI key for a short neutral opening on transaction posts and daily recaps.
# Trading and Oracle payments never require this key; factual post receipts have a local fallback.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Website conversation requires OpenAI. Enable this when you want public
# visitors to use the capped AI chat endpoint for follow-up questions.
WEB_CHAT_ENABLED=false
WEB_CHAT_MODEL=gpt-4o-mini

# Governance deployment. These are intentionally unset until holders approve the parameters.
# Use a separate deployment wallet; the deployment script never reads AGENT_PRIVATE_KEY.
GOVERNANCE_DEPLOYER_PRIVATE_KEY=
# Defaults to PONS_TOKEN_ADDRESS when omitted.
GOVERNANCE_TOKEN_ADDRESS=
GOVERNANCE_EXPECTED_CHAIN_ID=4663
GOVERNANCE_VOTING_DELAY_SECONDS=
GOVERNANCE_VOTING_PERIOD_SECONDS=
GOVERNANCE_PROPOSAL_THRESHOLD_TOKENS=
GOVERNANCE_QUORUM_PERCENT=
GOVERNANCE_TIMELOCK_DELAY_SECONDS=
# Optional; defaults to .runtime/governance-deployment.json.
GOVERNANCE_DEPLOYMENT_OUTPUT=
# Required exact value for a deployment: DEPLOY_AFTERHOURS_GOVERNANCE
DEPLOY_GOVERNANCE_CONFIRM=

# Transitional treasury deployment. Deployment starts paused and does not
# redirect Pons fees or transfer assets. Review contracts/README.md first.
PONS_FACTORY_ADDRESS=0x7eD598BcEf8bd9Edd8C97A195C6d13f40801EC7e
TREASURY_QUOTE_TOKEN_ADDRESS=0x5fc5360D0400a0Fd4f2af552ADD042D716F1d168
TREASURY_INITIAL_ADMIN_ADDRESS=
# Leave zero for the first treasury. A successor must name its predecessor.
TREASURY_MIGRATION_SOURCE_ADDRESS=0x0000000000000000000000000000000000000000
# Optional; defaults to .runtime/treasury-deployment.json.
TREASURY_DEPLOYMENT_OUTPUT=
# Required exact value for a deployment: DEPLOY_AFTERHOURS_TREASURY
DEPLOY_TREASURY_CONFIRM=
